{
  "name": "@agentique-console/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:handoffs": "tsx scripts/eval-handoffs.ts",
    "eval:orchestration": "vitest run evals/orchestration/structural.eval.test.ts",
    "eval:orchestration:live": "tsx evals/orchestration/live/run-live.ts",
    "eval:orchestration:judge": "tsx evals/orchestration/live/judge.ts",
    "eval:orchestration:compare": "tsx evals/orchestration/live/compare.ts",
    "import-legacy": "tsx scripts/import-legacy.ts"
  },
  "dependencies": {
    "@agentique-console/shared": "*",
    "@anthropic-ai/claude-agent-sdk": "0.3.226",
    "@fastify/static": "^10.1.2",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.6.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
